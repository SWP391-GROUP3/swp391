<mxCell id="root" value="com.swp391.kpi  (server/src/main/java)" style="shape=folder;tabWidth=340;tabHeight=30;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1260" height="1200" as="geometry"/></mxCell>
<mxCell id="grp" value="Package luồng nghiệp vụ (BF-01 … BF-05)" style="rounded=1;arcSize=2;dashed=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontStyle=2;fontSize=12;fontColor=#666666;fontFamily=Helvetica;fillColor=none;strokeColor=#9A9A9A;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1180" height="870" as="geometry"/></mxCell>
<mxCell id="article" value='&lt;b style="font-size:14px"&gt;article&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#555555"&gt;«BF-01 Viết &amp;amp; nộp bài»&lt;/i&gt;&lt;div style="font-size:12px;margin-top:4px;line-height:1.4"&gt;bài viết, đồng tác giả, phiên bản, tệp&lt;br&gt;engine: SimilarityChecker, ImageHasher&lt;br&gt;job: CoAuthorExpiryJob (hết hạn sau 3 ngày)&lt;/div&gt;' style="shape=folder;tabWidth=80;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=20;fontSize=12;fontFamily=Helvetica;fillColor=#EAF2FD;strokeColor=#4A86D8;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="assessment" value='&lt;b style="font-size:14px"&gt;assessment&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#555555"&gt;«BF-02 Phân công &amp;amp; đánh giá chất lượng»&lt;/i&gt;&lt;div style="font-size:12px;margin-top:4px;line-height:1.4"&gt;phân công, chấm theo bộ tiêu chí, duyệt điểm&lt;br&gt;event: ScoreChangedEvent&lt;/div&gt;' style="shape=folder;tabWidth=80;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=20;fontSize=12;fontFamily=Helvetica;fillColor=#EAF8EE;strokeColor=#3DA35D;" vertex="1" parent="1"><mxGeometry x="480" y="350" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="appeal" value='&lt;b style="font-size:14px"&gt;appeal&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#555555"&gt;«BF-03 Khiếu nại &amp;amp; kiểm soát điểm»&lt;/i&gt;&lt;div style="font-size:12px;margin-top:4px;line-height:1.4"&gt;khiếu nại → BTV khác chấm lại (hạn 7 ngày)&lt;br&gt;lệch &amp;gt; 5 điểm → thêm người chấm, lấy trung vị&lt;/div&gt;' style="shape=folder;tabWidth=80;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=20;fontSize=12;fontFamily=Helvetica;fillColor=#FFF3E6;strokeColor=#E07B1F;" vertex="1" parent="1"><mxGeometry x="110" y="580" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="royalty" value='&lt;b style="font-size:14px"&gt;royalty&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#555555"&gt;«BF-04 Chấm &amp;amp; chi nhuận bút»&lt;/i&gt;&lt;div style="font-size:12px;margin-top:4px;line-height:1.4"&gt;kỳ nhuận bút, chấm hệ số, bảng kê, phiếu chi&lt;br&gt;engine: RoyaltyCalculator, PhanBoTien&lt;br&gt;job: PaymentDeadlineJob&lt;br&gt;listener: ScoreChangedListener&lt;/div&gt;' style="shape=folder;tabWidth=80;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=20;fontSize=12;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#D4A017;" vertex="1" parent="1"><mxGeometry x="850" y="580" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="kpi" value='&lt;b style="font-size:14px"&gt;kpi&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#555555"&gt;«BF-05 KPI &amp;amp; báo cáo»&lt;/i&gt;&lt;div style="font-size:12px;margin-top:4px;line-height:1.4"&gt;chỉ tiêu tháng: Đạt / Chưa đạt&lt;br&gt;import CSV dữ liệu độc giả, báo cáo&lt;/div&gt;' style="shape=folder;tabWidth=80;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=20;fontSize=12;fontFamily=Helvetica;fillColor=#F5ECFB;strokeColor=#9B59B6;" vertex="1" parent="1"><mxGeometry x="850" y="790" width="320" height="125" as="geometry"/></mxCell>
<mxCell id="admin" value='&lt;b style="font-size:14px"&gt;admin&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#555555"&gt;«Nền tảng &amp;amp; quản trị»&lt;/i&gt;&lt;div style="font-size:12px;margin-top:4px;line-height:1.4"&gt;đăng nhập: AuthController (cấp JWT)&lt;br&gt;users, roles, sections&lt;br&gt;genres (hệ số), media_factors, system_parameters&lt;/div&gt;' style="shape=folder;tabWidth=80;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=20;fontSize=12;fontFamily=Helvetica;fillColor=#F4F4F4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="110" y="1030" width="480" height="150" as="geometry"/></mxCell>
<mxCell id="common" value='&lt;b style="font-size:14px"&gt;common&lt;/b&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#555555"&gt;«Dùng chung – sửa phải báo cả nhóm»&lt;/i&gt;&lt;div style="font-size:12px;margin-top:4px;line-height:1.4"&gt;config: SecurityConfig, CorsConfig&lt;br&gt;security: JwtAuthFilter, JwtService&lt;br&gt;response: ApiResponse · exception: GlobalExceptionHandler&lt;br&gt;notification: NotificationService · storage: FileStorageService&lt;/div&gt;' style="shape=folder;tabWidth=80;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=20;fontSize=12;fontFamily=Helvetica;fillColor=#EAEFF5;strokeColor=#5B6B7F;" vertex="1" parent="1"><mxGeometry x="690" y="1030" width="480" height="150" as="geometry"/></mxCell>
<mxCell id="note1" value="&lt;b&gt;Quy tắc phụ thuộc&lt;/b&gt;&lt;br&gt;1. Mũi tên nét đứt A → B: A gọi service của B. Sơ đồ không có vòng lặp.&lt;br&gt;2. Mọi package luồng dùng admin và common: vẽ 1 mũi tên từ khung, không vẽ từng package.&lt;br&gt;3. Không gọi repository của package khác, chỉ gọi qua service.&lt;br&gt;4. assessment phát ScoreChangedEvent, royalty nghe event → assessment không gọi royalty.&lt;br&gt;5. Đổi trạng thái bài viết luôn qua ArticleService (ghi article_status_logs)." style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Helvetica;fillColor=#FFFBE6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="1250" width="760" height="135" as="geometry"/></mxCell>
<mxCell id="note2" value="&lt;b&gt;Cấu trúc con của mỗi package luồng&lt;/b&gt;&lt;br&gt;controller/ · service/ · repository/ · entity/ · dto/&lt;br&gt;(+ engine/ · job/ · event/ · listener/ khi cần)" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Helvetica;fillColor=#FFFBE6;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="800" y="1250" width="480" height="135" as="geometry"/></mxCell>
